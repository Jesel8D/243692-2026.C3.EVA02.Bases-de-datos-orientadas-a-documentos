# Optional local copy: /workspace/.env.monitoring; never source this as shell.
MONITORING_PROJECT_NAME=jsonbench-monitoring
MONITORING_PROMETHEUS_URL=http://127.0.0.1:19090
MONITORING_PORT=19090
MONITORING_RETENTION=7d
MONITORING_RETENTION_SIZE=0B
MONITORING_MIN_FREE_MB=1024
MONITORING_ACCEPT_HOST_ACCESS=false
MONITORING_SPILL_CAPTURE=false
MONITORING_DOCKER_ROOT=/var/lib/docker
